rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Medical reports are strictly restricted to the authenticated patient or reviewing clinicians
    match /patients/{uid}/reports/{reportId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'doctor');
      
      // Upload limits: must be authenticated owner, under 25MB, and valid document MIME types
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|text/plain');
    }
  }
}
