rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication & Ownership Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDoctor() {
      return isAuthenticated() && exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
    }
    
    // Verified Connection Helper: Checks if doctor has an accepted connection with patient
    function hasApprovedDoctorConnection(patientId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/connections/$('conn_' + patientId + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/connections/$('conn_' + patientId + '_' + request.auth.uid)).data.status == 'accepted'
      );
    }

    // User Profiles: Users read their own profile; role is strictly immutable after creation
    match /users/{userId} {
      allow read: if isOwner(userId) || isDoctor();
      allow create: if isOwner(userId) && request.resource.data.role in ['patient', 'doctor'];
      // CRITICAL: Prevent role tampering/privilege escalation after creation
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if false; // Profiles cannot be arbitrarily deleted from client
    }

    // Doctor Profiles: Authenticated users can read doctor profiles to verify doctor codes
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(doctorId);
      allow delete: if false;
    }

    // Doctor-Patient Connections: Strictly accessible to the participating patient and doctor
    match /connections/{connId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid || 
        request.resource.data.doctorId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid
      );
    }

    // Patient Records: Patients have full control; doctors can read ONLY if accepted connection exists
    match /patients/{patientId} {
      allow read: if isOwner(patientId) || hasApprovedDoctorConnection(patientId);
      allow write: if isOwner(patientId);
    }

    // Medical Reports: Strictly restricted to patient owner or approved connected clinician
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid || 
        resource.data.patientId == request.auth.uid || 
        hasApprovedDoctorConnection(resource.data.patientId)
      );
      allow write: if isAuthenticated() && (
        request.resource.data.uploadedBy == request.auth.uid || 
        request.resource.data.patientId == request.auth.uid
      );
    }

    // Extracted Labs & Biomarkers: Patient owner or approved clinician
    match /labs/{labId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        hasApprovedDoctorConnection(resource.data.patientId)
      );
      allow write: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid || 
        (isDoctor() && hasApprovedDoctorConnection(request.resource.data.patientId))
      );
    }

    match /labResults/{labId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        hasApprovedDoctorConnection(resource.data.patientId)
      );
      allow write: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid || 
        (isDoctor() && hasApprovedDoctorConnection(request.resource.data.patientId))
      );
    }

    // Medications & Allergies
    match /medications/{medId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        hasApprovedDoctorConnection(resource.data.patientId)
      );
      allow write: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid || 
        (isDoctor() && hasApprovedDoctorConnection(request.resource.data.patientId))
      );
    }

    // Timeline Events
    match /timelineEvents/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        hasApprovedDoctorConnection(resource.data.patientId)
      );
      allow write: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid || 
        (isDoctor() && hasApprovedDoctorConnection(request.resource.data.patientId))
      );
    }

    // Verifications: Scoped to patient or authorized reviewer
    match /verifications/{verifId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        hasApprovedDoctorConnection(resource.data.patientId)
      );
      allow write: if isDoctor();
    }

    // Audit Log: Read scoped to authorized patient/doctor; write authenticated with actorId check
    match /auditLog/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        hasApprovedDoctorConnection(resource.data.patientId)
      );
      allow write: if isAuthenticated() && request.resource.data.actorId == request.auth.uid;
    }
  }
}
