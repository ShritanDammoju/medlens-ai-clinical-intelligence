# ============================================================
# MedLens Environment Configuration
# ============================================================

# Firebase Web App Configuration (from Firebase Console -> Project Settings)
# Project ID: medlens-e06ad
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=medlens-e06ad.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=medlens-e06ad
VITE_FIREBASE_STORAGE_BUCKET=medlens-e06ad.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# Server-Side Environment Variables (Vercel Project Settings & .env.local)
# Secure credentials used strictly on the server/backend API routes
# ============================================================
# Google Gemini API Key for Gemini 3.8 Flash (Server-Only, never exposed to client)
GEMINI_API_KEY=

# Optional: Override Gemini Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
